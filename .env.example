# Copie este arquivo para .env e troque os valores.
# O .env NUNCA vai para o Git.
# Precisou de uma variavel nova? Adicione aqui tambem, com valor ficticio.

# Banco de dados (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=estoque
POSTGRES_USER=estoque_app
POSTGRES_PASSWORD=troque_esta_senha

# Chave que assina o cookie de sessao
SECRET_KEY=troque_esta_chave
